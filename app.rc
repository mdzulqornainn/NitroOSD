#include <winuser.h>
1 ICON "app.ico"
1 24 "app.manifest"
1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "ProductName", "Nitro OSD"
      VALUE "FileDescription", "Nitro OSD"
      VALUE "FileVersion", "1.1.0.0"
      VALUE "ProductVersion", "1.1.0.0"
      VALUE "InternalName", "NitroOSD"
      VALUE "OriginalFilename", "NitroOSD.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
